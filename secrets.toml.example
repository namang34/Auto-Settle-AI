# Auto-Settle AI — Streamlit Secrets Template
# Copy this to Streamlit Cloud → Settings → Secrets
# Or save as .streamlit/secrets.toml for local dev
#
# DO NOT commit this file with real API keys to GitHub!

[ai]
type = "openai"                                               # "openai" for OpenAI-compatible APIs, "anthropic" for Claude, "ollama" for local
model_name = "gemini-2.0-flash"                                # model name (must support images)
base_url = "https://generativelanguage.googleapis.com/v1beta/openai"  # base URL for the API
api_key = "YOUR_API_KEY_HERE"                                  # your API key
