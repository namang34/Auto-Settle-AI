# Auto-Settle AI — Streamlit Secrets
# Paste this in Streamlit Cloud → App Settings → Secrets
# Replace api_key with your real key from https://aistudio.google.com/apikey
# DO NOT commit this file with a real key to GitHub.

[ai]
type = "openai"
model_name = "gemini-2.5-flash"
base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
api_key = "YOUR_GEMINI_API_KEY_HERE"

# --- Other supported options ---

